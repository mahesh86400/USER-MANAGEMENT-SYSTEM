<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <link rel="stylesheet" href="/css/users.css">
</head>
<body>

<div class="container">
    <h1>All Users</h1>

    <a href="/users/new" class="add-btn">+ Add User</a>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>

        <% users.forEach((user)=>{ %>

            <tr>

                <td><%= user.id %></td>

                <td><%= user.username %></td>

                <td><%= user.email %></td>

                <td>
                    <a href="/users/<%= user.id %>" class="detail-btn">View</a>
                </td>

            </tr>

        <% }) %>

        </tbody>

    </table>

</div>

</body>
</html>